# 环境变量配置示例
# 复制此文件为 .env.development 或 .env.production 并根据实际环境修改
# API 基础地址
# 开发环境示例: http://localhost/Utrada%20CRM/back-end/index.php?path=api
# 生产环境示例: /Utrada%20CRM/back-end/index.php?path=api 或 https://your-domain.com/back-end/index.php?path=api
VITE_API_BASE_URL=http://localhost/Utrada%20CRM/back-end/index.php?path=api

# 客户端 API 基础路径（可选，用于直接访问 API 文件）
# 开发环境示例: http://localhost/Utrada%20CRM/back-end
# 生产环境示例: /Utrada%20CRM/back-end 或 https://your-domain.com/back-end
# VITE_CLIENT_API_BASE_URL=http://localhost/Utrada%20CRM/back-end
