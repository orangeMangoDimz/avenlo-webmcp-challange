server {
    server_name devadmin.utrada.com;

    root /var/www/utrada/admin_frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /index.php {
        proxy_pass http://127.0.0.1:80;
        proxy_set_header Host api.yourdomain.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/devcrm.utrada.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/devcrm.utrada.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = devadmin.utrada.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name devadmin.utrada.com;
    return 404; # managed by Certbot


}
