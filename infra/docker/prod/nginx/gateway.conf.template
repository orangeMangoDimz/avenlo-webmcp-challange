map $http_origin $cors_origin {
    default "";
    "${ADMIN_ORIGIN}" $http_origin;
    "${CLIENT_ORIGIN}" $http_origin;
    "${ADMIN_ALT_ORIGIN}" $http_origin;
    "${CLIENT_ALT_ORIGIN}" $http_origin;
}

server {
    listen 80;
    server_name ${ADMIN_HOST} ${CLIENT_HOST} ${API_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_HOST};

    ssl_certificate /etc/letsencrypt/live/${TLS_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TLS_CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass api:9000;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Vary Origin always;
    }

    location / {
        proxy_pass http://admin:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CLIENT_HOST};

    ssl_certificate /etc/letsencrypt/live/${TLS_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TLS_CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass api:9000;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Vary Origin always;
    }

    location ~ ^/(api/callback/[^/]+/(deposit|withdrawal)|success/(callback|redirect)|decline/(callback|redirect))/?$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass api:9000;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Vary Origin always;
    }

    location ^~ /uploads/ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass api:9000;
    }

    location / {
        proxy_pass http://client:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_HOST};

    ssl_certificate /etc/letsencrypt/live/${TLS_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TLS_CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50m;

    location ~* ^/(logs|runtime|storage|database|config|vendor|composer\.(json|lock)|composer\.phar) {
        return 404;
    }

    location ~ /\.(?!well-known) {
        return 404;
    }

    location / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass api:9000;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Vary Origin always;
    }
}
