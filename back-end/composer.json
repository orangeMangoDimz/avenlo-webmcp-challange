{
  "name": "utrada/crm-backend-api",
  "description": "Utrada CRM Backend RESTful API",
  "version": "2.1.0",
  "type": "project",
  "keywords": [
    "crm",
    "api",
    "restful",
    "php",
    "mysql"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "Utrada Team",
      "email": "dev@utrada.com"
    }
  ],
  "require": {
    "php": ">=7.4.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "aws/aws-sdk-php": "2.*",
    "geoip2/geoip2": "^2.13"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "serve": "php -S localhost:8000 -t ."
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "7.4.33"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
